# Settings for local development. Copy this file to `.env` (git-ignored) and set the ID of
# the sandbox project. The Makefile also reads it (Terraform project and state bucket).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Where traces go: cloud (the default when GOOGLE_CLOUD_PROJECT is set), console or none.
IMPOSTER_TELEMETRY=cloud
