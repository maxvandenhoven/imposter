# Optional: copy to `terraform.tfvars` (git-ignored) to override defaults. The project ID
# comes from `GOOGLE_CLOUD_PROJECT` in `.env`, which `make` passes as `TF_VAR_project_id`.
# region = "europe-west4"
# labels = { app = "imposter" }
# Principals that IAP lets in. Without any, nobody can open the service.
# iap_members = ["user:you@example.com"]
# Budgets are created when the billing account is set (`gcloud billing projects describe`).
# billing_account_id   = "000000-000000-000000"
# budget_amount        = 20
# vertex_budget_amount = 50
# budget_emails        = ["you@example.com"]
